@model List<MyHRExample.Models.ResumeViewModel>

@{
    ViewData["Title"] = "Резюме кандидатів";
}

<div class="client-page">

    <div class="client-top">
        <div>
            <div class="client-small-title">HR MANAGEMENT SYSTEM</div>
            <h1>Резюме кандидатів</h1>
            <p>Список усіх отриманих відгуків та результати AI-аналізу</p>
        </div>

        <a href="/" class="client-back">
            ← На головну
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-message success">
            <span>✔</span> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message error">
            <span>⚠</span> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Count > 0)
    {
        <div class="candidates-grid">
            @foreach (var resume in Model)
            {
                <div class="candidate-card">
                    <div class="card-header">
                        <div class="candidate-avatar">
                            👤
                        </div>
                        <div class="candidate-main-info">
                            <h3>@resume.CandidateName</h3>
                            <span class="candidate-date">Завантажено: @resume.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy о HH:mm")</span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="info-row">
                            <span class="label">Email:</span>
                            <a href="mailto:@resume.Email" class="value-link">@resume.Email</a>
                        </div>
                        <div class="info-row">
                            <span class="label">Телефон:</span>
                            <a href="tel:@resume.Phone" class="value-link">@resume.Phone</a>
                        </div>
                        <div class="info-row">
                            <span class="label">Файл:</span>
                            <span class="file-badge">@resume.FileName</span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <a asp-controller="Resumes"
                           asp-action="Analysis"
                           asp-route-id="@resume.Id"
                           class="btn-gemini">
                            ✨ Аналіз Gemini
                        </a>

                        <div class="footer-actions">
                            <a asp-controller="Resumes"
                               asp-action="Open"
                               asp-route-key="@resume.S3Key"
                               class="btn-action btn-open"
                               target="_blank" title="Відкрити оригінал резюме">
                                📄 Файл
                            </a>

                            <form asp-controller="Resumes"
                                  asp-action="Delete"
                                  method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="key" value="@resume.S3Key" />
                                <input type="hidden" name="metadataKey" value="@resume.S3Key.Replace(".pdf", ".json")" />
                                <button type="submit"
                                        class="btn-action btn-delete"
                                        onclick="return confirm('Ви впевнені, що хочете видалити це резюме?');" title="Видалити">
                                    🗑
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📂</div>
            <h2>Резюме поки немає</h2>
            <p>Отримані резюме кандидатів автоматично з'являтимуться тут після відгуку на вакансії.</p>
        </div>
    }

</div>

<style>
    /* Сучасний та чистий дизайн */
    .client-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: #2d3748;
    }

    .client-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 20px;
    }

    .client-small-title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #4f46e5;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .client-top h1 {
        font-size: 28px;
        font-weight: 800;
        color: #1a202c;
        margin: 0 0 5px 0;
    }

    .client-top p {
        color: #718096;
        margin: 0;
        font-size: 15px;
    }

    .client-back {
        background: #f7fafc;
        border: 1px solid #e2e8f0;
        padding: 8px 16px;
        border-radius: 8px;
        color: #4a5568;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s;
    }

        .client-back:hover {
            background: #edf2f7;
            color: #1a202c;
        }

    /* Сповіщення */
    .alert-message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .alert-message.success {
            background-color: #f0fdf4;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-message.error {
            background-color: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

    /* Сітка карток замість нудної таблиці */
    .candidates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
    }

    .candidate-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .candidate-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
        }

    .card-header {
        padding: 20px;
        background: #f8fafc;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .candidate-avatar {
        width: 45px;
        height: 45px;
        background: #e0e7ff;
        color: #4f46e5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .candidate-main-info h3 {
        margin: 0 0 4px 0;
        font-size: 18px;
        color: #1e293b;
    }

    .candidate-date {
        font-size: 12px;
        color: #64748b;
    }

    .card-body {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
    }

    .label {
        color: #64748b;
        font-weight: 500;
    }

    .value-link {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 500;
    }

        .value-link:hover {
            text-decoration: underline;
        }

    .file-badge {
        background: #f1f5f9;
        color: #475569;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 13px;
        font-family: monospace;
    }

    .card-footer {
        padding: 15px 20px;
        background: #f8fafc;
        border-top: 1px solid #edf2f7;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn-gemini {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        text-align: center;
        padding: 10px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 2px 4px rgba(79, 70, 229, 0.2);
        transition: opacity 0.2s;
    }

        .btn-gemini:hover {
            opacity: 0.9;
            color: white;
        }

    .footer-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid #cbd5e1;
        background: white;
        color: #334155;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-action:hover {
            background: #f1f5f9;
        }

    .btn-delete {
        color: #dc2626;
        border-color: #fca5a5;
        background: #fff5f5;
    }

        .btn-delete:hover {
            background: #fee2e2;
        }

    /* Пустий стан */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: #f8fafc;
        border-radius: 16px;
        border: 2px dashed #e2e8f0;
    }

    .empty-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .empty-state h2 {
        color: #1e293b;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #64748b;
        max-width: 400px;
        margin: 0 auto;
    }
</style>